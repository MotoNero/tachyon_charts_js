              "null"
            ]
          },
          "yAxis": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": true,
          "data": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "sample",
                  "csv",
                  "live",
                  "medicalFile",
                  "hdf5",
                  "file"
                ]
              },
